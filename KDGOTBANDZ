        local vehicleFlyLoopStopped = false

        getgenv().MintPhillyVehicleFlyConnection = {
            Disconnect = function()
                vehicleFlyLoopStopped = true
            end
        }

        task.spawn(function()
            while not vehicleFlyLoopStopped do
                task.wait(0.04)

                if not vehicleFlyEnabled then
                    setVehicleFlyInputCapture(false)
                    if vehicleFlySeat or vehicleFlyBodyVelocity or vehicleFlyBodyGyro then
                        cleanupVehicleFly()
                    end
                else
                    local seat = getCurrentVehicleSeat()
                    if seat then
                        setVehicleFlyInputCapture(true)
                        ensureVehicleFlyForSeat(seat)

                        local camera = workspace.CurrentCamera
                        local cameraCF = camera and camera.CFrame or seat.CFrame
                        local forward = Vector3.new(cameraCF.LookVector.X, 0, cameraCF.LookVector.Z)
                        if forward.Magnitude <= 0.001 then
                            forward = Vector3.new(seat.CFrame.LookVector.X, 0, seat.CFrame.LookVector.Z)
                        end
                        forward = forward.Magnitude > 0 and forward.Unit or Vector3.new(0, 0, -1)

                        local right = Vector3.new(cameraCF.RightVector.X, 0, cameraCF.RightVector.Z)
                        if right.Magnitude <= 0.001 then
                            right = Vector3.new(seat.CFrame.RightVector.X, 0, seat.CFrame.RightVector.Z)
                        end
                        right = right.Magnitude > 0 and right.Unit or Vector3.new(1, 0, 0)

                        local move = Vector3.zero
                        if UIS:IsKeyDown(Enum.KeyCode.W) then move += forward end
                        if UIS:IsKeyDown(Enum.KeyCode.S) then move -= forward end
                        if UIS:IsKeyDown(Enum.KeyCode.A) then move -= right end
                        if UIS:IsKeyDown(Enum.KeyCode.D) then move += right end

                        local vertical = 0
                        if vehicleFlyUpHeld then vertical += 1 end
                        if vehicleFlyDownHeld then vertical -= 1 end

                        if move.Magnitude > 0 then
                            move = move.Unit
                        end

                        local desiredVelocity = (move * vehicleFlySpeed) + Vector3.new(0, vertical * vehicleFlySpeed, 0)
                        vehicleFlyBodyVelocity.Velocity = desiredVelocity

                        local lookDirection = move.Magnitude > 0 and move or forward
                        if lookDirection.Magnitude <= 0.001 then
                            lookDirection = Vector3.new(seat.CFrame.LookVector.X, 0, seat.CFrame.LookVector.Z)
                        end
                        if lookDirection.Magnitude > 0.001 then
                            vehicleFlyBodyGyro.CFrame = CFrame.lookAt(seat.Position, seat.Position + lookDirection.Unit, Vector3.yAxis)
                        end
                    else
                        setVehicleFlyInputCapture(false)
                        cleanupVehicleFly()
                    end
                end
            end

            setVehicleFlyInputCapture(false)
            cleanupVehicleFly()
        end)

        local function findOwnedVehicle()
            local vehiclesFolder = workspace:FindFirstChild("Vehicles")
            if not vehiclesFolder then
                return nil
            end

            local loweredName = LocalPlayer.Name:lower()
            for _, vehicle in ipairs(vehiclesFolder:GetChildren()) do
                if vehicle:FindFirstChildWhichIsA("VehicleSeat", true) then
                    local vehicleName = vehicle.Name:lower()
                    if vehicleName:find(loweredName, 1, true) then
                        return vehicle
                    end
                end
            end

            return nil
        end

        local function prepareVehicleForSeat(vehicle)
            if not vehicle then
                return
            end

            local function tryUnlockInstance(instance)
                if instance:IsA("BoolValue") then
                    local lowered = instance.Name:lower()
                    if lowered == "locked" or lowered == "islocked" or lowered == "lock" then
                        pcall(function()
                            instance.Value = false
                        end)
                    elseif lowered == "usable" then
                        pcall(function()
                            instance.Value = true
                        end)
                    end
                elseif instance:IsA("VehicleSeat") then
                    pcall(function()
                        instance.Disabled = false
                    end)
                end

                for attributeName, attributeValue in pairs(instance:GetAttributes()) do
                    local lowered = string.lower(attributeName)
                    if typeof(attributeValue) == "boolean" then
                        if lowered == "locked" or lowered == "islocked" or lowered == "lock" then
                            pcall(function()
                                instance:SetAttribute(attributeName, false)
                            end)
                        elseif lowered == "usable" then
                            pcall(function()
                                instance:SetAttribute(attributeName, true)
                            end)
                        end
                    end
                end
            end

            tryUnlockInstance(vehicle)
            for _, descendant in ipairs(vehicle:GetDescendants()) do
                tryUnlockInstance(descendant)
            end
        end

