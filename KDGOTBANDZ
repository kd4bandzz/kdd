        local rgbGunCachedTargets = {}
        local rgbGunTargetKinds = setmetatable({}, {__mode = "k"})
        local rgbGunLastUpdate = 0
        local rgbGunRescanToken = 0
        local rgbGunExcludedNameFragments = {
            "shell",
            "casing",
            "muzzle",
            "flash",
            "smoke",
            "trail",
            "beam",
            "particle",
            "spark",
            "light",
            "bullet",
            "projectile",
            "flare",
            "eject",
        }

        pcall(function()
