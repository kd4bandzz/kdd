                buildRgbVehicleTargets(model)
            end

            local now = tick()
            if now - rgbVehicleLastUpdate < 0.18 then
                return
            end
            rgbVehicleLastUpdate = now

            local rainbowColor = Color3.fromHSV((tick() * 0.35) % 1, 1, 1)
            local rainbowVector = Vector3.new(rainbowColor.R, rainbowColor.G, rainbowColor.B)
            local targets = rgbVehicleCachedTargets[model] or buildRgbVehicleTargets(model)

            for _, descendant in ipairs(targets) do
                if descendant and descendant.Parent then
                    local kind = rgbVehicleTargetKinds[descendant]

                    if kind == "BasePart" then
                        rememberRgbVehicleState(descendant, {Kind = kind, Color = descendant.Color})
                        descendant.Color = rainbowColor
                    elseif kind == "SpecialMesh" then
                        rememberRgbVehicleState(descendant, {Kind = kind, VertexColor = descendant.VertexColor})
                        descendant.VertexColor = rainbowVector
                    elseif kind == "DecalTexture" then
                        rememberRgbVehicleState(descendant, {Kind = kind, Color3 = descendant.Color3})
                        descendant.Color3 = rainbowColor
                    end
                end
            end
        end

        getgenv().MintPhillyRgbVehicleCleanup = function()
            restoreRgbVehicle(rgbVehicleCurrentVehicle)
        end

