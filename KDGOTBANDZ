        local function spectatePlayer(enable)
            SpectateSessionToken += 1
            SpectateEnabled = enable

            if SpectateConnection then
                SpectateConnection:Disconnect()
                SpectateConnection = nil
            end

            if not enable then
                forceRestoreLocalCamera()
                return true
            end

            if not SelectedPlayer then
                SpectateEnabled = false
                forceRestoreLocalCamera()
                return false
            end

            local camera = workspace.CurrentCamera
            local lastSpectatePosition
            local lastSpectateLook = Vector3.new(0, 0, -1)
            local lastStreamRequest = 0
            local sessionToken = SpectateSessionToken

            SpectateConnection = game:GetService("RunService").RenderStepped:Connect(function()
                if not SpectateEnabled or sessionToken ~= SpectateSessionToken then
                    return
                end

                if not SelectedPlayer then
                    SpectateEnabled = false
                    forceRestoreLocalCamera()
                    return
                end

                local character = SelectedPlayer.Character
                if not character then
                    SpectateEnabled = false
                    forceRestoreLocalCamera(false)
                    return
                end

                local hrp = character:FindFirstChild("HumanoidRootPart")
                local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
                local head = character:FindFirstChild("Head")
                local focusPart = hrp or torso or head or character:FindFirstChildWhichIsA("BasePart", true)
                local focusCFrame = focusPart and focusPart.CFrame or nil

                if not focusCFrame then
                    pcall(function()
                        focusCFrame = character:GetPivot()
                    end)
                end

                if focusCFrame then
                    lastSpectatePosition = focusCFrame.Position
                    local rawLook = focusCFrame.LookVector
                    if rawLook.Magnitude > 0.001 then
                        lastSpectateLook = rawLook.Unit
                    end
                end

                if tick() - lastStreamRequest >= 0.35 then
                    lastStreamRequest = tick()
                    if focusPart then
                        pcall(function()
                            LocalPlayer.ReplicationFocus = focusPart
                        end)
                        pcall(function()
                            if typeof(LocalPlayer.RequestStreamAroundAsync) == "function" then
                                LocalPlayer:RequestStreamAroundAsync(focusPart.Position)
                            end
                        end)
                    elseif focusCFrame then
                        pcall(function()
                            if typeof(LocalPlayer.RequestStreamAroundAsync) == "function" then
                                LocalPlayer:RequestStreamAroundAsync(focusCFrame.Position)
                            end
                        end)
                    elseif lastSpectatePosition then
                        pcall(function()
                            if typeof(LocalPlayer.RequestStreamAroundAsync) == "function" then
                                LocalPlayer:RequestStreamAroundAsync(lastSpectatePosition)
                            end
                        end)
                    end
                end

                if not lastSpectatePosition then
                    SpectateEnabled = false
                    forceRestoreLocalCamera(false)
                    return
                end

                local offset = (-lastSpectateLook * 10) + Vector3.new(0, 3, 0)
                camera.CameraType = Enum.CameraType.Scriptable
                camera.CFrame = CFrame.new(lastSpectatePosition + offset, lastSpectatePosition)
            end)

            return true
        end

