        local function getCurrentVehicleSeat()
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local seatPart = humanoid and humanoid.SeatPart
            if seatPart and seatPart:IsA("VehicleSeat") then
                return seatPart
            end
            return nil
        end

        local function cleanupVehicleFly()
            local seat = vehicleFlySeat
            local vehicleModel = seat and seat:FindFirstAncestorOfClass("Model")

            if vehicleFlyBodyVelocity then
                pcall(function()
                    vehicleFlyBodyVelocity.Velocity = Vector3.zero
                    vehicleFlyBodyVelocity:Destroy()
                end)
                vehicleFlyBodyVelocity = nil
            end

            if vehicleFlyBodyGyro then
                pcall(function()
                    vehicleFlyBodyGyro.MaxTorque = Vector3.zero
                    vehicleFlyBodyGyro:Destroy()
                end)
                vehicleFlyBodyGyro = nil
            end

            if seat then
                pcall(function()
                    seat.AssemblyAngularVelocity = Vector3.zero
                    seat.RotVelocity = Vector3.zero
                end)
            end

            if vehicleModel then
                for _, descendant in ipairs(vehicleModel:GetDescendants()) do
                    if descendant:IsA("BasePart") then
                        pcall(function()
                            descendant.AssemblyAngularVelocity = Vector3.zero
                            descendant.RotVelocity = Vector3.zero
                        end)
                    end
                end
            end

            vehicleFlySeat = nil
        end

        local function setVehicleFlyInputCapture(enabled)
            if vehicleFlyInputsCaptured == enabled then
                return
            end

            vehicleFlyInputsCaptured = enabled
            vehicleFlyUpHeld = false
            vehicleFlyDownHeld = false

            pcall(function()
                CAS:UnbindAction(VehicleFlyUpAction)
                CAS:UnbindAction(VehicleFlyDownAction)
            end)

            if not enabled then
                return
            end

            CAS:BindActionAtPriority(VehicleFlyUpAction, function(_, inputState)
                vehicleFlyUpHeld = inputState == Enum.UserInputState.Begin or inputState == Enum.UserInputState.Change
                if inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
                    vehicleFlyUpHeld = false
                end
                return Enum.ContextActionResult.Sink
            end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift)

            CAS:BindActionAtPriority(VehicleFlyDownAction, function(_, inputState)
                vehicleFlyDownHeld = inputState == Enum.UserInputState.Begin or inputState == Enum.UserInputState.Change
                if inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
                    vehicleFlyDownHeld = false
                end
                return Enum.ContextActionResult.Sink
            end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl)
        end

