Library:Configs(window)

if UIS.TouchEnabled and window and window.Items then
    task.defer(function()
        local items = window.Items
        local uiWindow = items.Window

        if uiWindow then
            local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(0, 0)
            local windowWidth = uiWindow.Size.X.Offset
            local windowHeight = uiWindow.Size.Y.Offset
            local targetWidth = windowWidth

            if viewport.X > 0 then
                local desiredWidth = math.max(windowWidth, math.floor(viewport.X * 0.92))
                targetWidth = math.min(desiredWidth, math.max(320, viewport.X - 8), 760)
            end

            uiWindow.Size = UDim2.fromOffset(targetWidth, windowHeight)

            local offsetX = 0

            if viewport.X > 0 then
                local minMargin = 8
                local desiredLeftEdge = 72
                local maxLeftEdge = math.max(minMargin, viewport.X - targetWidth - minMargin)
                local leftEdge = math.clamp(desiredLeftEdge, minMargin, maxLeftEdge)

                offsetX = math.floor(leftEdge - (viewport.X * 0.5))
            end

            uiWindow.Position = UDim2.new(0.5, offsetX, 0.5, -math.floor(windowHeight / 2))
            window.WindowPosition = uiWindow.Position
        end

        local tabHolder = items.TabHolder
        local tabHolderFrame = items.TabHolderFrame
        if tabHolder and tabHolderFrame and not tabHolder:IsA("ScrollingFrame") then
            local scrollHolder = Instance.new("ScrollingFrame")
            scrollHolder.Name = tabHolder.Name
            scrollHolder.Parent = tabHolderFrame
            scrollHolder.BackgroundTransparency = 1
            scrollHolder.BorderSizePixel = 0
            scrollHolder.Position = tabHolder.Position
            scrollHolder.Size = tabHolder.Size
            scrollHolder.CanvasSize = UDim2.new(0, 0, 0, 0)
            scrollHolder.AutomaticCanvasSize = Enum.AutomaticSize.Y
            scrollHolder.ScrollBarThickness = 6
            scrollHolder.ScrollBarImageColor3 = Color3.fromRGB(80, 108, 98)
            scrollHolder.ScrollingDirection = Enum.ScrollingDirection.Y
            scrollHolder.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable
            scrollHolder.ScrollingEnabled = true
            scrollHolder.ClipsDescendants = true

            for _, child in ipairs(tabHolder:GetChildren()) do
                child.Parent = scrollHolder
            end

            tabHolder:Destroy()
            items.TabHolder = scrollHolder

            local layout = scrollHolder:FindFirstChildOfClass("UIListLayout")
            if layout then
                local function updateTabCanvas()
                    scrollHolder.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
                end

                updateTabCanvas()
                layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateTabCanvas)
            end
        end

        local menuButton = items.MenuButton
        if menuButton then
            local lockedMenuButtonPosition = menuButton.Position
            local resettingMenuButtonPosition = false

            menuButton:GetPropertyChangedSignal("Position"):Connect(function()
                if resettingMenuButtonPosition then
                    return
                end

                if menuButton.Position ~= lockedMenuButtonPosition then
                    resettingMenuButtonPosition = true
                    menuButton.Position = lockedMenuButtonPosition
                    resettingMenuButtonPosition = false
                end
            end)
        end

    end)
end

