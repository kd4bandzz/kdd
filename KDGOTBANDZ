        local function PlayMainTabEmote(animationId)
            local character = LocalPlayer.Character
            if not character or not character.Parent then
                ShowMainTabNotification("Your character is not ready yet.")
                return false
            end

            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if not humanoid or humanoid.Health <= 0 then
                ShowMainTabNotification("You need to be alive to play emotes.")
                return false
            end

            if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
                ShowMainTabNotification("Custom emotes need an R15 character here.")
                return false
            end

            local animator = humanoid:FindFirstChildOfClass("Animator")
            if not animator then
                animator = Instance.new("Animator")
                animator.Parent = humanoid
            end

            StopMainTabEmote(0.1)

            if TryPlayMainTabCatalogEmote(humanoid, animationId) then
                return true
            end

            local resolvedAnimationId = ResolveMainTabEmoteAnimationId(animationId)
            if not resolvedAnimationId then
                ShowMainTabNotification("Couldn't resolve that emote asset here.")
                return false
            end

            local animation = Instance.new("Animation")
            animation.AnimationId = resolvedAnimationId

            local success, track = pcall(function()
                return animator:LoadAnimation(animation)
            end)

            animation:Destroy()

            if not success or not track then
                ShowMainTabNotification("Couldn't load that emote right now.")
                return false
            end

            BindMainTabEmoteTrack(humanoid, track)

            local playSuccess = pcall(function()
                track:Play(0.15, 1, 1)
            end)

            if not playSuccess then
                if currentMainEmoteTrack == track then
                    StopMainTabEmote(0)
                end

                ShowMainTabNotification("The emote failed to play.")
                return false
            end

            return true
        end

