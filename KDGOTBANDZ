            end

            for instance, state in pairs(rgbVehicleOriginalState) do
                if instance and instance.Parent then
                    restoreRgbVehicleInstance(instance, state)
                end
            end

            if rgbVehicleCurrentVehicle == model then
                rgbVehicleCurrentVehicle = nil
            end

            table.clear(rgbVehicleOriginalState)
