local function GetMintRainbowColor(offset)
    return Color3.fromHSV((tick() * 0.18 + (offset or 0)) % 1, 1, 1)
end

local function GetVisualColor(baseColor, rgbEnabled, offset)
    return rgbEnabled and GetMintRainbowColor(offset) or baseColor
end

local function GetVisualGradientColors(rgbEnabled, colorOne, colorTwo, offset)
    if rgbEnabled then
        local hueOffset = offset or 0
        return GetMintRainbowColor(hueOffset), GetMintRainbowColor(hueOffset + 0.18)
    end

    return colorOne, colorTwo
end

