            for _, descendant in ipairs(playerGui:GetDescendants()) do
                if descendant:IsA("LocalScript") then
                    local loweredName = string.lower(descendant.Name)
                    if string.find(loweredName, "hunger", 1, true) or string.find(loweredName, "food", 1, true) then
                        if hungerScriptStates[descendant] == nil then
                            hungerScriptStates[descendant] = descendant.Disabled
                        end
                        descendant.Disabled = enabled
                    end
                end
            end

            if not enabled then
                for scriptInstance, wasDisabled in pairs(hungerScriptStates) do
