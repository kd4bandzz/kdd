        local function TryPlayMainTabCatalogEmote(humanoid, assetId)
            local numericAssetId = tonumber(tostring(assetId):match("%d+"))
            if not numericAssetId then
                return false
            end

            local emoteName = "MintHubEmote_" .. tostring(numericAssetId)
            local previousTracks = {}
            local capturedTrack
            local captureConnection

            for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
                previousTracks[track] = true
            end

            local humanoidDescription
            local usedDescriptionCopy = false

            local directDescriptionSuccess, directDescription = pcall(function()
                return humanoid.HumanoidDescription
            end)

            if directDescriptionSuccess and typeof(directDescription) == "Instance" and directDescription:IsA("HumanoidDescription") then
                humanoidDescription = directDescription
            else
                local descriptionSuccess, descriptionResult = pcall(function()
                    return humanoid:GetAppliedDescription()
                end)

                if not descriptionSuccess or not descriptionResult then
                    return false
                end

                humanoidDescription = descriptionResult
                usedDescriptionCopy = true
            end

            local preparedEmote = pcall(function()
                humanoidDescription:RemoveEmote(emoteName)
                humanoidDescription:AddEmote(emoteName, numericAssetId)
                humanoidDescription:SetEquippedEmotes({emoteName})
            end)

            if not preparedEmote then
                return false
            end

            if usedDescriptionCopy then
                local appliedDescription = pcall(function()
                    humanoid:ApplyDescriptionAsync(humanoidDescription)
                end)

                if not appliedDescription then
                    return false
                end
            end

            captureConnection = humanoid.AnimationPlayed:Connect(function(newTrack)
                if not capturedTrack then
                    capturedTrack = newTrack
                end
            end)

            local playSuccess, playResult = pcall(function()
                if humanoid.PlayEmoteAsync then
                    return humanoid:PlayEmoteAsync(emoteName)
                end

                return humanoid:PlayEmote(emoteName)
            end)

            if captureConnection then
                captureConnection:Disconnect()
                captureConnection = nil
            end

            if not playSuccess or not playResult then
                return false
            end

            local activeTrack = capturedTrack
            if not activeTrack then
                for _ = 1, 12 do
                    for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
                        if not previousTracks[track] then
                            activeTrack = track
                            break
                        end
                    end

                    if activeTrack then
                        break
                    end

                    task.wait(0.05)
                end
            end

            if activeTrack then
                local trackAnimation = activeTrack.Animation
                local resolvedTrackAnimationId = trackAnimation and trackAnimation.AnimationId
                if resolvedTrackAnimationId and resolvedTrackAnimationId ~= "" then
                    local cacheKey = tostring(assetId)
                    cachedMainTabEmoteAnimationIds[cacheKey] = resolvedTrackAnimationId
                    failedMainTabEmoteAnimationResolutions[cacheKey] = nil
                end

                currentMainEmoteTrack = activeTrack

                pcall(function()
                    activeTrack.Priority = Enum.AnimationPriority.Action4
                end)

                activeTrack.Stopped:Connect(function()
                    if currentMainEmoteTrack == activeTrack then
                        StopMainTabEmote(0)
                    end
                end)

                StartMainTabEmoteSuppression(humanoid, activeTrack)
                return true
            end

            return false
        end

