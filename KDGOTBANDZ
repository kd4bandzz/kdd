local customSkyLightingState = nil
local customSkyApplied = false
local customSkyEnabled = false
local skyPresetDefinitions = {
    ["Meme"] = "11818627075",
    ["Clean Anime Sky"] = "1049060234",
    ["Purple Anime Sky"] = "5725566168",
    ["Aesthetic Anime Sky"] = "6437957577",
    ["SZA"] = "13556964168",
    ["The Rock"] = "8425069728",
}
local selectedSkyPreset = "SZA"

local function normalizeSkyTextureId(input)
    if typeof(input) ~= "string" then
        return nil
    end

    local cleaned = input:gsub("%s+", "")
    if cleaned == "" then
        return nil
    end

    if cleaned:match("^rbxassetid://") or cleaned:match("^https?://") then
        return cleaned
    end

    local assetId = cleaned:match("%d+")
    if not assetId then
        return nil
    end

    return "rbxassetid://" .. assetId
end

local function getOrCreateSky()
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if not sky then
        sky = Instance.new("Sky")
        sky.Name = "MintCustomSky"
        sky.Parent = Lighting
    end

    return sky
end

local function captureSkyData(sky)
    if not sky then
        return nil
    end

    return {
        Mode = "Skybox",
        SkyboxBk = sky.SkyboxBk,
        SkyboxDn = sky.SkyboxDn,
        SkyboxFt = sky.SkyboxFt,
        SkyboxLf = sky.SkyboxLf,
        SkyboxRt = sky.SkyboxRt,
        SkyboxUp = sky.SkyboxUp,
        SunTextureId = sky.SunTextureId,
        MoonTextureId = sky.MoonTextureId,
        StarCount = sky.StarCount
    }
end

local function findTextureLikeInstance(root)
    if not root then
        return nil
    end

    if root:IsA("Decal") or root:IsA("Texture") or root:IsA("ImageLabel") or root:IsA("ImageButton") then
        return root
    end

    return root:FindFirstChildWhichIsA("Decal", true)
        or root:FindFirstChildWhichIsA("Texture", true)
        or root:FindFirstChildWhichIsA("ImageLabel", true)
        or root:FindFirstChildWhichIsA("ImageButton", true)
end

local function extractTextureLikeContentId(value)
    if value == nil then
        return nil
    end

    if typeof(value) == "string" then
        return normalizeSkyTextureId(value)
    end

    local ok, asString = pcall(function()
        return tostring(value)
    end)

    if ok and typeof(asString) == "string" then
        return normalizeSkyTextureId(asString)
    end

    return nil
end

local function getTextureLikeContentId(instance)
    if not instance then
        return nil
    end

    local propertyNames = {
        "Texture",
        "TextureContent",
        "ColorMap",
        "ColorMapContent",
        "Image",
        "ImageContent"
    }

    for _, propertyName in ipairs(propertyNames) do
        local ok, value = pcall(function()
            return instance[propertyName]
        end)

        if ok then
            local resolvedId = extractTextureLikeContentId(value)
            if resolvedId then
                return resolvedId
            end
        end
    end

    return nil
end

local function resolveSkyTextureData(input)
    local normalizedId = normalizeSkyTextureId(input)
    if not normalizedId then
        return nil
    end

    local ok, loadedObjects = pcall(game.GetObjects, game, normalizedId)
    if ok and typeof(loadedObjects) == "table" then
        for _, object in ipairs(loadedObjects) do
            local loadedSky = object:IsA("Sky") and object or object:FindFirstChildOfClass("Sky")
            local skyData = captureSkyData(loadedSky)
            if skyData then
                return skyData
            end

            local textureLike = findTextureLikeInstance(object)
            local textureId = getTextureLikeContentId(textureLike)
            if textureId then
                return {
                    Mode = "Texture",
                    Texture = textureId
                }
            end
        end
    end

    return {
        Mode = "Texture",
        Texture = normalizedId
    }
end

local function applyResolvedSkyData(resolvedData)
    if not resolvedData then
        return false
    end

    local sky = getOrCreateSky()
    if resolvedData.Mode == "Skybox" then
        sky.SkyboxBk = resolvedData.SkyboxBk
        sky.SkyboxDn = resolvedData.SkyboxDn
        sky.SkyboxFt = resolvedData.SkyboxFt
        sky.SkyboxLf = resolvedData.SkyboxLf
        sky.SkyboxRt = resolvedData.SkyboxRt
        sky.SkyboxUp = resolvedData.SkyboxUp
        sky.SunTextureId = resolvedData.SunTextureId
        sky.MoonTextureId = resolvedData.MoonTextureId
        sky.StarCount = resolvedData.StarCount
    else
        sky.SkyboxBk = resolvedData.Texture
        sky.SkyboxDn = resolvedData.Texture
        sky.SkyboxFt = resolvedData.Texture
        sky.SkyboxLf = resolvedData.Texture
        sky.SkyboxRt = resolvedData.Texture
        sky.SkyboxUp = resolvedData.Texture
        sky.SunTextureId = ""
        sky.MoonTextureId = ""
        sky.StarCount = 0
    end

    customSkyApplied = true
    return true
end

local function applyCustomSkyLighting()
    if not customSkyLightingState then
        customSkyLightingState = {
            ClockTime = Lighting.ClockTime,
            Brightness = Lighting.Brightness,
            ExposureCompensation = Lighting.ExposureCompensation
        }
    end

    local clockTime = Lighting.ClockTime
    if clockTime >= 18 or clockTime <= 6 then
        Lighting.ClockTime = 7
    end

    if Lighting.Brightness < 2 then
        Lighting.Brightness = 2
    end

    if Lighting.ExposureCompensation < 0.35 then
        Lighting.ExposureCompensation = 0.35
    end
end

local function restoreCustomSkyLighting()
    if not customSkyLightingState then
        return
    end

    Lighting.ClockTime = customSkyLightingState.ClockTime
    Lighting.Brightness = customSkyLightingState.Brightness
    Lighting.ExposureCompensation = customSkyLightingState.ExposureCompensation
    customSkyLightingState = nil
end

local function applySkyTexture(textureId)
    customSkyResolvedData = resolveSkyTextureData(textureId)
    if not customSkyResolvedData then
        return false
    end

    local applied = applyResolvedSkyData(customSkyResolvedData)
    if applied then
        applyCustomSkyLighting()
    end

    return applied
end

local function resetSkyTexture()
    local currentSky = Lighting:FindFirstChildOfClass("Sky")
    if currentSky then
        currentSky:Destroy()
    end

    if originalSkyClone then
        originalSkyClone:Clone().Parent = Lighting
    end

    customSkyApplied = false
    customSkyEnabled = false
    customSkyResolvedData = nil
    restoreCustomSkyLighting()
end

