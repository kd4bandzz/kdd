            if existingConnection and existingConnection.Disconnect then
                existingConnection:Disconnect()
                getgenv().MintPhillyRgbGunConnection = nil
            end
        end)

        local function isRgbGunEffectName(name)
            local lowered = string.lower(name or "")
            for _, fragment in ipairs(rgbGunExcludedNameFragments) do
                if string.find(lowered, fragment, 1, true) then
                    return true
                end
            end
            return false
        end

        local function getAllGunSettings()
            local guns = {}

            local function scan(container)
                for _, item in ipairs(container:GetChildren()) do
                    if item:IsA("Tool") and item:FindFirstChild("Settings") and item.Settings:IsA("ModuleScript") then
                        table.insert(guns, item.Settings)
                    end
                end
            end

            scan(LocalPlayer.Backpack)
            if LocalPlayer.Character then
                scan(LocalPlayer.Character)
            end

            return guns
        end

        local function cacheOriginal(gunSettings, moduleId)
            if OriginalSettings[moduleId] then return end
            OriginalSettings[moduleId] = {
                jamChance = gunSettings.jamChance,
                spread = gunSettings.spread,
                semiCooldown = gunSettings.semiCooldown,
                autoCooldown = gunSettings.autoCooldown,
                fireMode = gunSettings.fireMode,
                projectiles = gunSettings.projectiles,
            }
        end

        local function applyMod(callback)
            for _, mod in ipairs(getAllGunSettings()) do
                local success, gunSettings = pcall(require, mod)
                if success and type(gunSettings) == "table" then
                    cacheOriginal(gunSettings, mod:GetDebugId())
                    callback(gunSettings)
                end
            end
        end

        local function rememberRgbState(instance, state)
            if rgbGunOriginalState[instance] == nil then
                rgbGunOriginalState[instance] = state
            end
        end

        local function restoreRgbInstance(instance, state)
            pcall(function()
                if state.Kind == "BasePart" then
                    instance.Color = state.Color
                elseif state.Kind == "SpecialMesh" then
                    instance.VertexColor = state.VertexColor
                elseif state.Kind == "DecalTexture" then
                    instance.Color3 = state.Color3
                end
            end)
        end

        local function restoreRgbGunTool(tool)
            if not tool then
                rgbGunCurrentTool = nil
                rgbGunRescanToken += 1
                table.clear(rgbGunOriginalState)
                table.clear(rgbGunCachedTargets)
                return
            end

            for instance, state in pairs(rgbGunOriginalState) do
                if instance and instance.Parent then
                    restoreRgbInstance(instance, state)
                end
            end

            if rgbGunCurrentTool == tool then
                rgbGunCurrentTool = nil
            end

            rgbGunRescanToken += 1
            table.clear(rgbGunOriginalState)
            table.clear(rgbGunCachedTargets)
        end

        local function getHeldGunTool()
            local character = LocalPlayer.Character
            local tool = character and character:FindFirstChildOfClass("Tool")
            if tool and (
                (tool:FindFirstChild("Settings") and tool.Settings:IsA("ModuleScript")) or
                tool:FindFirstChild("Setting") or
                tool:FindFirstChild("GunScript_Local")
            ) then
                return tool
            end
            return nil
        end

        local function buildRgbGunTargets(tool)
            local targets = {}
            local seen = {}
            local toolVisualNameCounts = {}

            local function addTarget(instance, kind)
                if instance and not seen[instance] then
                    seen[instance] = true
                    table.insert(targets, instance)
                    rgbGunTargetKinds[instance] = kind
                end
            end

            local function scan(container, collectNames)
                for _, descendant in ipairs(container:GetDescendants()) do
                    if not isRgbGunEffectName(descendant.Name) then
                        if collectNames then
                            local loweredName = string.lower(descendant.Name)
                            toolVisualNameCounts[loweredName] = (toolVisualNameCounts[loweredName] or 0) + 1
                        end

                        if descendant:IsA("BasePart") then
                            addTarget(descendant, "BasePart")
                        elseif descendant:IsA("SpecialMesh") then
                            local parent = descendant.Parent
                            if parent and parent:IsA("BasePart") and not isRgbGunEffectName(parent.Name) then
                                addTarget(descendant, "SpecialMesh")
                            end
                        elseif descendant:IsA("Decal") or descendant:IsA("Texture") then
                            local parent = descendant.Parent
                            if parent and not isRgbGunEffectName(parent.Name) then
                                addTarget(descendant, "DecalTexture")
                            end
                        end
                    end
                end
            end

            scan(tool, true)

            local camera = workspace.CurrentCamera
            if camera then
                local bestCameraModel = nil
                local bestCameraScore = 0

                for _, candidate in ipairs(camera:GetDescendants()) do
                    if candidate:IsA("Model") then
                        local candidateNameLower = string.lower(candidate.Name)
                        local score = candidateNameLower == string.lower(tool.Name) and 6 or 0

                        for _, candidateDescendant in ipairs(candidate:GetDescendants()) do
                            if not isRgbGunEffectName(candidateDescendant.Name) then
                                local overlap = toolVisualNameCounts[string.lower(candidateDescendant.Name)]
                                if overlap then
                                    score += overlap
                                end
                            end
                        end

                        if score > bestCameraScore then
                            bestCameraScore = score
                            bestCameraModel = candidate
                        end
                    end
                end

                if bestCameraModel and bestCameraScore >= 3 then
                    scan(bestCameraModel, false)
                end
            end

            rgbGunCachedTargets[tool] = targets
            return targets
        end

        local function queueRgbGunRescan(tool)
            rgbGunRescanToken += 1
            local token = rgbGunRescanToken

            task.delay(0.35, function()
                if rgbGunEnabled and rgbGunCurrentTool == tool and token == rgbGunRescanToken then
                    buildRgbGunTargets(tool)
                end
            end)
        end

        local function applyRgbGunTool(tool)
            if not tool then
                return
            end

            if rgbGunCurrentTool ~= tool then
                restoreRgbGunTool(rgbGunCurrentTool)
                rgbGunCurrentTool = tool
                buildRgbGunTargets(tool)
                queueRgbGunRescan(tool)
            end

            local now = tick()
            if now - rgbGunLastUpdate < 0.18 then
                return
            end
            rgbGunLastUpdate = now

            local rainbowColor = Color3.fromHSV((tick() * 0.35) % 1, 1, 1)
            local rainbowVector = Vector3.new(rainbowColor.R, rainbowColor.G, rainbowColor.B)
            local targets = rgbGunCachedTargets[tool] or buildRgbGunTargets(tool)

            for _, descendant in ipairs(targets) do
                if descendant and descendant.Parent then
                    local kind = rgbGunTargetKinds[descendant]

                    if kind == "BasePart" then
                        rememberRgbState(descendant, {Kind = kind, Color = descendant.Color})
                        descendant.Color = rainbowColor
                    elseif kind == "SpecialMesh" then
                        rememberRgbState(descendant, {Kind = kind, VertexColor = descendant.VertexColor})
                        descendant.VertexColor = rainbowVector
                    elseif kind == "DecalTexture" then
                        rememberRgbState(descendant, {Kind = kind, Color3 = descendant.Color3})
                        descendant.Color3 = rainbowColor
                    end
                end
            end
        end

        getgenv().MintPhillyRgbGunCleanup = function()
            restoreRgbGunTool(rgbGunCurrentTool)
        end

        local rgbGunLoopStopped = false

        getgenv().MintPhillyRgbGunConnection = {
            Disconnect = function()
                rgbGunLoopStopped = true
            end
        }

        task.spawn(function()
            while not rgbGunLoopStopped do
                task.wait(0.18)

                if not rgbGunEnabled then
                    if rgbGunCurrentTool then
                        restoreRgbGunTool(rgbGunCurrentTool)
                    end
                else
                    local heldTool = getHeldGunTool()
                    if heldTool then
                        applyRgbGunTool(heldTool)
                    elseif rgbGunCurrentTool then
                        restoreRgbGunTool(rgbGunCurrentTool)
                    end
                end
            end
        end)

