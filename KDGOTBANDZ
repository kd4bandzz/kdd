        local function GetExpandedHitboxRayTarget(origin, direction)
            if not Config.MiscSettings.Hitbox_Expander.Enabled then
                return nil, nil
            end

            if typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" then
                return nil, nil
            end

            local rayLength = direction.Magnitude
            if rayLength <= 25 or not IsLikelyLocalShotRay(origin) then
                return nil, nil
            end

            local rayDirection = direction.Unit
            local bestPart = nil
            local bestPoint = nil
            local bestDistance = nil
            local targetPartName = Config.MiscSettings.Hitbox_Expander.Part
            local radius = math.max(Config.MiscSettings.Hitbox_Expander.Multiplier * 0.5, 0.5)

            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and not table.find(library.whitelist, player.Name) then
                    local character = player.Character
                    local humanoid = character and character:FindFirstChild("Humanoid")
                    local part = character and character:FindFirstChild(targetPartName)

                    if character and humanoid and humanoid.Health > 0 and part and part:IsA("BasePart") and character.Parent ~= nil then
                        local offset = part.Position - origin
                        local projectedDistance = offset:Dot(rayDirection)

                        if projectedDistance >= 0 and projectedDistance <= (rayLength + radius) then
                            local closestPoint = origin + (rayDirection * projectedDistance)
                            local perpendicularDistance = (part.Position - closestPoint).Magnitude

                            if perpendicularDistance <= radius then
                                local distanceToCenter = (part.Position - origin).Magnitude
                                local aimPoint = part.Position

                                if bestDistance == nil or distanceToCenter < bestDistance then
                                    bestDistance = distanceToCenter
                                    bestPart = part
                                    bestPoint = aimPoint
                                end
                            end
                        end
                    end
                end
            end

            return bestPart, bestPoint
        end
        
