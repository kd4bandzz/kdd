                        local closestPrompt
                        local closestDistance
                        local searchRadius = maxDistance or 10

                        for _, descendant in ipairs(House:GetDescendants()) do
                            if descendant:IsA("ProximityPrompt") and descendant.Enabled then
                                local promptPosition = resolvePromptPosition(descendant)
                                if promptPosition then
                                    local distance = (promptPosition - position).Magnitude
                                    if distance <= searchRadius and (not closestDistance or distance < closestDistance) then
                                        closestPrompt = descendant
                                        closestDistance = distance
                                    end
                                end
                            end
                        end

                        return closestPrompt
                    end

