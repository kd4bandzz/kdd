        local function forceRestoreLocalCamera(resetReplicationFocus)
            local restoreToken = SpectateSessionToken

            local function tryRestore()
                if SpectateEnabled or restoreToken ~= SpectateSessionToken then
                    return
                end

                restoreLocalCamera(resetReplicationFocus)
