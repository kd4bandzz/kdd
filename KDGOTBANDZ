                local foodTarget = type(maxFood) == "number" and maxFood or 100

                for _, attributeName in ipairs({"Hunger", "hunger"}) do
                    if settingsObj:GetAttribute(attributeName) ~= nil then
                        settingsObj:SetAttribute(attributeName, hungerTarget)
                    end
